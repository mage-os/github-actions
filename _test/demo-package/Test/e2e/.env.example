# The store the suite opens. There is no default: a suite that silently tests
# someone else's demo store is worse than one that refuses to start.
PLAYWRIGHT_BASE_URL=https://app.mageos.test/

# The admin account warden/setup-environment creates, and the frontname
# setup:install was given. Defaults in admin/support.ts match the action, so
# these only need setting when pointing the suite at some other store.
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=abcABC123
MAGENTO_ADMIN_FRONTNAME=admin
